# Sanity project id — turns the CMS + embedded Studio (/studio) on.
# Leave blank to run the site entirely on seed content (src/content).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset. Defaults to "production" when blank.
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token with write ("Editor") access. Required for `npm run seed`
# and for lead capture. Server-only — never expose this to the browser.
SANITY_API_TOKEN=

# Absolute site URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.arihantgroup.in

# Plausible analytics. Cookieless, so no consent banner is required.
# Leave BLANK and no analytics script is emitted at all — the site ships with
# zero third-party requests until this is filled in.
# Set to the domain as registered in Plausible, e.g. arihantgroup.in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Only needed for a self-hosted Plausible instance. Defaults to plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Sanity project id — turns the CMS + embedded Studio (/studio) on.
# Leave blank to run the site entirely on seed content (src/content).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset. Defaults to "production" when blank.
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token with write ("Editor") access. Needed ONLY for `npm run seed`.
# It is not used at runtime, so it does not belong in the hosting provider's
# environment. Server-only — never expose this to the browser.
SANITY_API_TOKEN=

# Contact-form enquiries are emailed, not stored in the CMS: a free-plan Sanity
# dataset is public, so a lead document would expose a prospect's name, phone
# and email to anyone. All three of these must be set or the live form refuses
# submissions and tells the visitor to call instead.
#   RESEND_API_KEY    resend.com -> API Keys
#   LEAD_NOTIFY_FROM  a sender on a domain verified in Resend, e.g.
#                     "Arihant Website <website@arihantgroup.in>"
#   LEAD_NOTIFY_TO    who receives them; comma separate for several people
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# Shared secret for the Sanity webhook that makes Studio edits appear on the
# live site within seconds (POST /api/revalidate). Use a long random string and
# paste the SAME value into the webhook's "Secret" field in sanity.io.
# Blank means the endpoint refuses every request, and published edits then wait
# for the hourly fallback instead of appearing immediately.
SANITY_REVALIDATE_SECRET=

# Absolute site URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.arihantgroup.in

# Plausible analytics. Cookieless, so no consent banner is required.
# Leave BLANK and no analytics script is emitted at all — the site ships with
# zero third-party requests until this is filled in.
# Set to the domain as registered in Plausible, e.g. arihantgroup.in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Only needed for a self-hosted Plausible instance. Defaults to plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=
